{
  "id": "dlg_001",
  "kb": "kb.pl",
  "description": "Многоходовые диалоги — проверка coreference (он/ему/у него) и эллипсиса (А у ...?).",
  "dialogs": [
    {
      "id": "dlg_001_a",
      "title": "Информация о директоре",
      "turns": [
        {
          "turn": 1,
          "nl": "Кто директор технопарка Саратов?",
          "query_hint": "edge(X, 'технопарк_саратов', 'директор')",
          "answer_var": "X",
          "expected_answers": ["иванов_иван"]
        },
        {
          "turn": 2,
          "nl": "А сколько ему лет?",
          "coref": "ему → иванов_иван",
          "query_hint": "attribute('иванов_иван', 'возраст', X)",
          "answer_var": "X",
          "expected_answers": ["45"]
        },
        {
          "turn": 3,
          "nl": "А где он работает?",
          "coref": "он → иванов_иван",
          "query_hint": "edge('иванов_иван', X, 'работать_в')",
          "answer_var": "X",
          "expected_answers": ["технопарк_саратов"]
        }
      ]
    },
    {
      "id": "dlg_001_b",
      "title": "Сравнение технопарков (эллипсис)",
      "turns": [
        {
          "turn": 1,
          "nl": "Какая площадь у технопарка Москва?",
          "query_hint": "attribute('технопарк_москва', 'площадь', X)",
          "answer_var": "X",
          "expected_answers": ["25000_кв_м"]
        },
        {
          "turn": 2,
          "nl": "А у Казани?",
          "ellipsis": "attribute(технопарк_казань, площадь, X)",
          "query_hint": "attribute('технопарк_казань', 'площадь', X)",
          "answer_var": "X",
          "expected_answers": ["15000_кв_м"]
        },
        {
          "turn": 3,
          "nl": "А у Саратова?",
          "ellipsis": "attribute(технопарк_саратов, площадь, X)",
          "query_hint": "attribute('технопарк_саратов', 'площадь', X)",
          "answer_var": "X",
          "expected_answers": ["10000_кв_м"]
        }
      ]
    }
  ]
}